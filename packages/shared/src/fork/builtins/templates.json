    "requires": [],
    "definition": {
      "version": 3,
      "name": "Weekly SEO Check-up",
      "brief": "A weekly audit that fixes the top issues.",
      "tags": ["seo", "web", "growth"],
      "inputs": [
        {
          "id": "site",
          "label": "site",
          "kind": "text",
          "required": true
        }
      ],
      "steps": [
        {
          "id": "audit",
          "title": "Audit",
          "skill": "seo-audit",
          "note": "Audit {{input.site}}; rank the issues by impact"
        },
        {
          "id": "accessibility",
          "title": "Accessibility",
          "skill": "accessibility",
          "note": "WCAG pass on the top pages"
        },
        {
          "id": "plan",
          "title": "Plan",
          "skill": "research",
          "note": "Pick the 3 highest-impact fixes this week"
        },
        {
          "id": "fix",
          "title": "Fix",
          "skill": "frontend-design",
          "note": "Implement the 3 fixes"
        },
        {
          "id": "review",
          "title": "Review",
