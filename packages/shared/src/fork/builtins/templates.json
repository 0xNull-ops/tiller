  {
    "id": "weekly-growth-loop",
    "version": 1,
    "skills": {
      "analytics": "coreyhaines31/marketingskills/analytics",
      "landing-page-conversion-audit": "autonnel/autonnel-skills/landing-page-conversion-audit",
      "copywriting": "coreyhaines31/marketingskills/copywriting",
      "frontend-design": "anthropics/skills/frontend-design",
      "seo-audit": "coreyhaines31/marketingskills/seo-audit",
      "research": "mattpocock/skills/research"
    },
    "requires": ["loops"],
    "definition": {
      "version": 3,
      "name": "Weekly Growth Loop",
      "brief": "Every week, improve one page using last week's learnings.",
      "tags": ["growth", "web", "marketing"],
      "inputs": [
        {
          "id": "site",
          "label": "site",
          "kind": "text",
          "required": true
        },
        {
          "id": "page",
          "label": "page",
          "kind": "text",
          "required": true
        }
      ],
      "steps": [
        {
          "id": "analytics",
          "title": "Analytics",
          "skill": "analytics",
          "note": "What changed since last week; read {{last.result}}"
        },
        {
          "id": "conversion-audit",
          "title": "Conversion audit",
          "skill": "landing-page-conversion-audit",
          "note": "Audit /{{input.page}}"
        },
        {
          "id": "rewrite",
          "title": "Rewrite",
          "skill": "copywriting",
          "note": "Rewrite the weakest section"
        },
        {
          "id": "implement",
          "title": "Implement",
          "skill": "frontend-design",
          "note": "Ship the change behind a flag if one exists"
        },
        {
          "id": "seo",
          "title": "SEO",
          "skill": "seo-audit",
          "note": "Keep the meta and headings right"
        },
        {
          "id": "report",
          "title": "Report",
          "skill": "research",
          "note": "Review after. What we changed and what to measure next week",
          "pauseAfter": true
        }
      ],
      "trigger": "schedule"
    },
    "schedule": {
      "type": "fixed_time",
      "timeOfDay": "10:00",
      "weekdays": [5]
    },
    "knobs": {
      "carryOver": true,
      "rotate": {
        "inputId": "page",
        "values": ["home", "pricing", "features", "signup"],
        "next": 0
      }
    }
  },
