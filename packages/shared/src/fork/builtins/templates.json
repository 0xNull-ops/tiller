      "deploy-to-vercel": "vercel-labs/agent-skills/deploy-to-vercel"
    },
    "requires": [],
    "definition": {
      "version": 3,
      "name": "Landing Page in an Afternoon",
      "brief": "From a one-line idea to a deployed landing page.",
      "tags": ["web", "design", "launch"],
      "inputs": [
        {
          "id": "product",
          "label": "product",
          "kind": "text",
          "required": true
        },
        {
          "id": "audience",
          "label": "audience",
          "kind": "text",
          "required": true
        },
        {
          "id": "cta",
          "label": "cta",
          "kind": "text",
          "required": true
        }
      ],
      "steps": [
        {
          "id": "research",
          "title": "Research",
          "skill": "research",
          "note": "Who is {{input.audience}}; 3 competitors; their promise and proof"
        },
        {
          "id": "copy",
          "title": "Copy",
          "skill": "copywriting",
          "note": "Hero, 3 benefits, social proof, FAQ, CTA \"{{input.cta}}\""
        },
        {
          "id": "design-build",
          "title": "Design & build",
          "skill": "frontend-design",
          "note": "Build the page from the copy; responsive; no stock clichés"
        },
        {
          "id": "polish",
          "title": "Polish",
          "skill": "impeccable",
          "note": "Critique and fix hierarchy, spacing, type, contrast"
        },
        {
          "id": "deploy",
          "title": "Deploy",
          "skill": "deploy-to-vercel",
          "note": "Gate. Deploy a preview, and report the URL",
          "gate": true
        }
      ]
    }
  },
